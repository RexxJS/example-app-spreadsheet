// spec_app_sheet_files.ae — demo 18 run as an installed app (app/app.json):
// files the person picks, through documents. Headless, so each picker takes
// the answer the spec queued.
//   ./run-tests.sh spec_app_sheet_files
import std.spec
import std.string
import std.fs
import std.encoding
import std.os (os_getenv)
import saedriver as b
import griddriver as g
import uidriver

tmp_dir() -> string {
    t = os_getenv("TMPDIR")
    if t == null { return "/tmp" }
    while string.ends_with(t, "/") == 1 { t = string.substring(t, 0, string.length(t) - 1) }
    return t
}

main() {
    fw = spec.init()
    uidriver.wait_server()
    dir = "${tmp_dir()}/sae-sheet-files"
    _m = fs.mkdir_p(dir)
    _w1 = fs.write("${dir}/book.json", "{\"name\": \"Spec book\", \"formulas\": \"excel\", \"cells\": {\"A1\": \"2\", \"B1\": {\"content\": \"=A1*21\"}}}")
    _w2 = fs.write("${dir}/more.csv", "7,8\n9,10\n")
    // An XLSX made by hand (tests/headless/lib/xlsx_fixtures.ts's STORED).
    xlsx, _xe = encoding.base64_decode("")
    _w3 = fs.write_binary("${dir}/one.xlsx", string.bytes(xlsx))
    // And one with looks, a comment and validation (xlsx_fixtures.ts's STYLED).
    styled, _se = encoding.base64_decode("")
    _w4 = fs.write_binary("${dir}/looks.xlsx", string.bytes(styled))
    // And one with conditional formatting, a table, and parts to report (PARTS).
    partsx, _pe = encoding.base64_decode("")
    _w5 = fs.write_binary("${dir}/parts.xlsx", string.bytes(partsx))
    // And an OpenDocument spreadsheet (ODS).
    odsx, _oe = encoding.base64_decode("")
    _w6 = fs.write_binary("${dir}/stock.ods", string.bytes(odsx))
    // And an Excel 97-2003 workbook (xls_fixtures.ts's BOOK).
    xlsb, _xbe = encoding.base64_decode("")
    _w7 = fs.write_binary("${dir}/old.xls", string.bytes(xlsb))
    // And an encrypted XLSX (crypt_fixtures.ts's AGILE, password Secret1).
    lockb, _le = encoding.base64_decode("")
    _w8 = fs.write_binary("${dir}/locked.xlsx", string.bytes(lockb))
    _d1 = fs.delete("${dir}/saved.json")
    _d2 = fs.delete("${dir}/out.csv")
    spec.describe(fw, "demo 18 as an app: files the person picks") {
        spec.it("Open file reads a workbook in the Tauri app's format") callback {
            uidriver.answer_prompt("open", "${dir}/book.json")
            b.click("Open file")
            spec.assert_true(b.wait_for_console("sheet: opened Spec book: 2 cells, Excel formulas"), "opened")
            spec.assert_true(g.wait_cell("B", 1, "42"), "its formula worked out")
        }
        spec.it("Save file writes the workbook where the person chose") callback {
            uidriver.answer_prompt("save", "${dir}/saved.json")
            b.click("Save file")
            spec.assert_true(b.wait_for_console("sheet: saved saved.json"), "saved")
            body, _e = fs.read("${dir}/saved.json")
            spec.assert_contains(body, "\"name\":\"Spec book\"", "the workbook's name")
            spec.assert_contains(body, "\"expression\":\"A1*21\"", "and its formula")
            spec.assert_contains(uidriver.prompts(), "\"default_name\":\"Spec book.json\"", "the name suggested")
        }
        spec.it("Export CSV file writes what the sheet shows") callback {
            uidriver.answer_prompt("save", "${dir}/out.csv")
            b.click("Export CSV file")
            spec.assert_true(b.wait_for_console("sheet: exported out.csv"), "exported")
            body, _e = fs.read("${dir}/out.csv")
            spec.assert_contains(body, "2,42", "the values")
        }
        spec.it("Open file reads a CSV file in at the selected cell") callback {
            g.pick("D", 3)
            uidriver.answer_prompt("open", "${dir}/more.csv")
            b.click("Open file")
            spec.assert_true(g.wait_cell("E", 4, "10"), "at D3")
        }
        spec.it("a cancelled picker changes nothing") callback {
            uidriver.answer_prompt("open", "")
            b.click("Open file")
            spec.assert_true(g.wait_cell("B", 1, "42"), "still the same workbook")
        }
        spec.it("Open file reads an XLSX workbook, its bytes through documents") callback {
            uidriver.answer_prompt("open", "${dir}/one.xlsx")
            b.click("Open file")
            spec.assert_true(b.wait_for_console("sheet: opened one: 1 cells, Excel formulas"), "opened")
            spec.assert_true(g.wait_cell("A", 1, "1"), "its cell")
            uidriver.answer_prompt("open", "${dir}/book.json")
            b.click("Open file")
            spec.assert_true(g.wait_cell("B", 1, "42"), "and the workbook before it again, for what follows")
        }
        spec.it("an XLSX's looks drawn: a medium top border in a theme's accent, a dashed green bottom") callback {
            uidriver.answer_prompt("open", "${dir}/looks.xlsx")
            b.click("Open file")
            spec.assert_true(b.wait_for_console("sheet: opened looks: "), "opened")
            spec.assert_true(uidriver.wait_body_contains("/widget/${g.cell_id("B", 1)}", "\"borderTop\":\"2 #ed7d31\"", 40), "medium, accent 2")
            spec.assert_true(uidriver.wait_body_contains("/widget/${g.cell_id("B", 1)}", "\"borderBottom\":\"1 #00ff00\"", 40), "thin, green")
            uidriver.answer_prompt("open", "${dir}/book.json")
            b.click("Open file")
            spec.assert_true(g.wait_cell("B", 1, "42"), "and the workbook before it again")
        }
        spec.it("an XLSX's conditional formatting drawn, its table's totals worked out, what it held reported") callback {
            uidriver.answer_prompt("open", "${dir}/parts.xlsx")
            b.click("Open file")
            spec.assert_true(b.wait_for_console("left out: Rules!A2:A3: a dataBarX rule, left out; 1 chart left out; 1 picture left out; 1 pivot table left out; 1 sheet's sparkline group left out"), "the report")
            spec.assert_true(g.wait_cell("B", 4, "15"), "the totals row")
            spec.assert_true(uidriver.wait_body_contains("/widget/${g.cell_id("B", 3)}", "\"fg\":\"#4472c4\"", 40), "its formula rule's theme colour, stopping the next")
            uidriver.answer_prompt("open", "${dir}/book.json")
            b.click("Open file")
            spec.assert_true(g.wait_cell("B", 1, "42"), "and the workbook before it again")
        }
        spec.it("Open file reads an ODS spreadsheet's cached values") callback {
            uidriver.answer_prompt("open", "${dir}/stock.ods")
            b.click("Open file")
            spec.assert_true(b.wait_for_console("sheet: opened stock: 16 cells, Excel formulas; 1 formula read as the value cached"), "opened")
            spec.assert_true(g.wait_cell("C", 2, "6"), "a formula's cached value")
            spec.assert_true(g.wait_cell("D", 2, "25%"), "a percentage")
            uidriver.answer_prompt("open", "${dir}/book.json")
            b.click("Open file")
            spec.assert_true(g.wait_cell("B", 1, "42"), "and the workbook before it again")
        }
        spec.it("Open file reads an Excel 97-2003 workbook, its formulas from their tokens") callback {
            uidriver.answer_prompt("open", "${dir}/old.xls")
            b.click("Open file")
            spec.assert_true(b.wait_for_console("sheet: opened old: "), "opened")
            spec.assert_true(g.wait_cell("C", 2, "31"), "=SUM(B2:B3)*2 worked out")
            spec.assert_true(g.wait_cell("C", 3, "big!"), "and its IF")
            uidriver.answer_prompt("open", "${dir}/book.json")
            b.click("Open file")
            spec.assert_true(g.wait_cell("B", 1, "42"), "and the workbook before it again")
        }
        spec.it("an encrypted XLSX: refused with no password, opened by the password field's") callback {
            uidriver.answer_prompt("open", "${dir}/locked.xlsx")
            b.click("Open file")
            spec.assert_true(b.wait_for_console("sheet: refused: locked.xlsx is encrypted: open it with its password"), "asks for it")
            b.set_field_by("file password", "Secret1")
            uidriver.answer_prompt("open", "${dir}/locked.xlsx")
            b.click("Open file")
            spec.assert_true(b.wait_for_console("sheet: opened locked: 1 cells, Excel formulas"), "opened")
            spec.assert_eq(string.contains(b.page_texts(), "Secret1"), 0, "the password shown nowhere")
            b.set_field_by("file password", "")
            uidriver.answer_prompt("open", "${dir}/book.json")
            b.click("Open file")
            spec.assert_true(g.wait_cell("B", 1, "42"), "and the workbook before it again")
        }
        spec.it("Export PDF file writes the sheet as a PDF where the person chose") callback {
            uidriver.answer_prompt("save", "${dir}/out.pdf")
            b.click("Export PDF file")
            spec.assert_true(b.wait_for_console("sheet: exported out.pdf: Spec book.pdf: 1 page, "), "exported")
            body, n, _e = fs.read_binary("${dir}/out.pdf")
            spec.assert_true(n > 500, "a file")
            spec.assert_true(string.starts_with(body, "%PDF-1.4") == 1, "a PDF")
            spec.assert_true(string.contains(body, "(42) Tj") == 1, "its cell's value drawn")
        }
        spec.it("Save XLSX file writes the workbook as XLSX, and Open file reads it back") callback {
            uidriver.answer_prompt("save", "${dir}/round.xlsx")
            b.click("Save XLSX file")
            spec.assert_true(b.wait_for_console("sheet: saved round.xlsx"), "saved")
            bytes, n, _e = fs.read_binary("${dir}/round.xlsx")
            spec.assert_true(n > 500, "a file")
            spec.assert_eq(string.char_at(bytes, 0), 80, "a ZIP: P")
            spec.assert_eq(string.char_at(bytes, 1), 75, "K")
            spec.assert_contains(uidriver.prompts(), "\"default_name\":\"Spec book.xlsx\"", "the name suggested")
            uidriver.answer_prompt("open", "${dir}/round.xlsx")
            b.click("Open file")
            spec.assert_true(b.wait_for_console("sheet: opened round: 2 cells, Excel formulas"), "opened")
            spec.assert_true(g.wait_cell("B", 1, "42"), "its formula worked out again")
        }
    }
    spec.describe(fw, "the menu bar (an installed app's)") {
        spec.it("old Excel's menus, each item a panel's command, with its shortcut") callback {
            spec.assert_true(b.wait_for_console("sheet: menus: 9 menus, "), "made")
            body = uidriver.menus_body()
            spec.assert_contains(body, "\"Undo (Ctrl+Z)\",\"Redo (Ctrl+Y)\",\"Cut (Ctrl+X)\",\"Copy (Ctrl+C)\",\"Paste (Ctrl+V)\"", "Edit's first items, in order")
            spec.assert_true(uidriver.menu_handle_with("Calculate now (F9)") > 0, "Formulas has Calculate now")
            spec.assert_true(uidriver.menu_handle_with("Bold (Ctrl+B)") > 0, "Format has Bold")
        }
        spec.it("an item runs what its panel button runs") callback {
            g.goto("B1")
            uidriver.menu_activate_item("Bold (Ctrl+B)")
            spec.assert_true(b.wait_for_console("sheet: B1: bold"), "Format > Bold made B1 bold")
            uidriver.menu_activate_item("Undo (Ctrl+Z)")
            spec.assert_true(b.wait_for_console("sheet: undid"), "Edit > Undo took it back")
            uidriver.menu_activate_item("Manual calculation")
            spec.assert_true(b.wait_for_console("sheet: manual calculation"), "Formulas > Manual calculation")
            uidriver.menu_activate_item("Calculate now (F9)")
            spec.assert_true(b.wait_for_console("formula worked out"), "Formulas > Calculate now")
            uidriver.menu_activate_item("Manual calculation")
            spec.assert_true(b.wait_for_console("sheet: automatic calculation"), "and back")
            uidriver.menu_activate_item("Rules panel")
            spec.assert_true(b.wait_for_console("sheet: the rules panel"), "View > Rules panel opens it")
            uidriver.menu_activate_item("Find")
            spec.assert_true(b.wait_for_console("sheet: the find panel"), "Edit > Find opens its panel first")
            uidriver.menu_activate_item("Rules panel")
            spec.assert_true(b.wait_for_console("sheet: the rules panel"), "and back")
            uidriver.menu_activate_item("Rules panel")
            spec.assert_true(b.wait_for_console("sheet: no panel"), "and closed")
            uidriver.menu_activate_item("Run the setup script")
            spec.assert_true(b.wait_for_console("sheet: ran the setup script"), "a command with no button runs too")
        }
        spec.it("a link to a URL from the Insert panel, opened by the system (app.json grants https:)") callback {
            g.command("view.panel name=insert")
            g.goto("H2")
            b.set_field_by("link to", "https://example.org/sheet")
            b.set_field_by("link text", "Example")
            b.click("Link")
            spec.assert_true(b.wait_for_console("sheet: H2:H2 links to https://example.org/sheet"), "linked")
            spec.assert_true(g.wait_cell("H", 2, "Example"), "its text")
            b.click("Open link")
            spec.assert_true(b.wait_for_console("sheet: opened https://example.org/sheet"), "opened")
            lg, _e = fs.read(os_getenv("SAE_SHELL_LOG"))
            spec.assert_true(string.contains(lg, "https://example.org/sheet") == 1, "handed to the system (the shell log)")
            g.command("cell.hyperlink range=H3 target=ftp://example.org/")
            g.goto("H3")
            b.click("Open link")
            spec.assert_true(b.wait_for_console("sheet: refused: shell.open: this app may not open ftp://example.org/"), "a URL not granted is refused")
            g.command("view.panel name=none")
        }
    }
    return spec.run_summary(fw)
}
